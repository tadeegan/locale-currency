{
  "name": "locale-currency",
  "version": "1.1.0",
  "description": "A map of locale codes to ISO 4217 currency codes, plus currency decimal-place (minor unit) data. Supports BCP 47, i18n, and ISO 3166-1 alpha-2 formats.",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./decimals": {
      "types": "./currency-decimals.d.ts",
      "import": "./currency-decimals.js",
      "default": "./currency-decimals.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test.js && npm run test:types && npm run test:cjs",
    "test:types": "tsc --noEmit",
    "test:cjs": "node test-cjs.cjs"
  },
  "keywords": [
    "locale",
    "currency",
    "i18n",
    "internationalization",
    "BCP 47",
    "ISO 4217",
    "ISO 3166-1",
    "country code",
    "minor unit",
    "decimal places",
    "currency exponent",
    "smallest currency unit",
    "stripe"
  ],
  "author": {
    "name": "Thomas Deegan",
    "email": "tadeegan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tadeegan/locale-currency.git"
  },
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "map.js",
    "currency-decimals.js",
    "currency-decimals.d.ts"
  ],
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2"
  },
  "sideEffects": false
}
